# Cache
.cache/
.pytest_cache/
.ruff_cache/
*.cache

# Archives
*.zip
*.tar.gz
*.rar
*.7z

# Docs (not needed in image)
*.md

# Docker
docker-compose.override.yml

# Playwright browser cache
.playwright/
playwright-report/
test-results/

# Nuitka
*.build/
*.dist/
nuitka-crash-report*.xml

# Misc
