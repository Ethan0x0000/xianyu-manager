.env
.env.*
!.env.example
*.key
*.pem
*.crt

# Config (mount at runtime)
*.local.yml
*.dev.yml
*.test.yml
config.local.*
!global_config.yml

# Runtime directories (mount at runtime)
backups/
browser_data/
trajectory_history/

# Frontend build artifacts (built during docker build)
frontend/node_modules/
static/index.html
static/assets/

# Uploads
static/uploads/*
